# Copy this to .env — it is read by all three services.
#   cp .env.example .env

NODE_ENV=development
SERVICE_VERSION=0.1.0

# ---- service ports -------------------------------------------------------
# 3000 is taken by Grafana, so the services start at 3001.
API_GATEWAY_PORT=3001
ORDERS_SERVICE_PORT=3002
PAYMENTS_SERVICE_PORT=3003

# ---- where the services find the infrastructure --------------------------
# These are host addresses because the services run on your machine,
# not inside Docker.

DATABASE_URL=postgres://glassbox:glassbox@localhost:5432
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:29092

# ---- OpenTelemetry (used from step 3) ------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_LOG_LEVEL=error
