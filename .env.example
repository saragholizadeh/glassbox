# Settings for the three apps. Copy to .env:
#   cp .env.example .env

NODE_ENV=development
SERVICE_VERSION=0.1.0

# ---- ports ---------------------------------------------------------------
# Grafana uses 3000, so the apps start at 3001.
API_GATEWAY_PORT=3001
ORDERS_SERVICE_PORT=3002
PAYMENTS_SERVICE_PORT=3003

# ---- where the apps find the tools ----------------------------------------
# localhost, because the apps run on your machine, not in Docker.
DATABASE_URL=postgres://glassbox:glassbox@localhost:5432
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:29092

# OpenTelemetry is not set here. It starts before this file is read,
# so it uses its default: http://localhost:4318.
